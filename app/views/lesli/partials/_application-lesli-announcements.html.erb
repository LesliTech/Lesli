<%
    announcements = Array(@lesli_announcements).map do |announcement|
        {
            id: announcement.id,
            category: announcement.category,
            category_label: t("lesli.announcements.categories.#{announcement.category}", default: t("lesli.announcements.categories.info")),
            message: announcement.message,
            url: announcement.url,
            dismiss_url: announcement.can_be_closed? ? lesli_bell.dismiss_announcement_path(announcement) : nil
        }
    end
%>
<%= render LesliView::Partials::Announcements.new(
    announcements: announcements,
    label: t("lesli.announcements.title"),
    link_label: t("lesli.announcements.open_link"),
    dismiss_label: t("lesli.announcements.dismiss")
) %>
