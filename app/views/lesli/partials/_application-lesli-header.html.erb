<%
    engine_navigation_partial = navigation_partial
    notifications_count = @lesli&.dig(:notifications).to_i
    actions = []

    if defined?(LesliBell)
        path = lesli_bell.notifications_path
        label = if notifications_count.positive?
            plural = notifications_count == 1 ? "one" : "other"
            t("lesli.header.notifications_unread_#{plural}", count: notifications_count, default: "%{count} unread notifications")
        else
            t("lesli.header.notifications", default: "Notifications")
        end
        actions << {
            url: path, label: label, active: current_page?(path),
            icon: notifications_count.positive? ? "ri-notification-3-fill" : "ri-notification-3-line",
            highlighted: notifications_count.positive?, count: notifications_count,
            data: { turbo_frame: "_top" }
        }
    end

    actions << {
        url: lesli.apps_path, label: t("lesli.header.applications", default: "Applications"),
        icon: "ri-apps-2-line", active: current_page?(lesli.apps_path),
        data: { turbo_frame: "_top" }
    }

    if defined?(LesliShield)
        actions << {
            url: lesli_shield.profile_path, label: t("lesli.header.profile", default: "Profile"),
            icon: "ri-user-smile-line", data: { turbo_frame: "_top" }
        }
        actions << {
            url: main_app.destroy_user_session_path, label: t("lesli.header.logout", default: "Logout"),
            icon: "ri-logout-circle-r-line"
        }
    end
%>
<%= render LesliView::Partials::Header.new(
    home_url: application_dashboard_path,
    home_label: t("lesli.header.dashboard", default: "Lesli Dashboard"),
    actions: actions,
    actions_label: t("lesli.header.actions", default: "Application actions"),
    navigation_label: t("lesli.header.navigation", default: "Module navigation")
) do |header| %>
    <% header.with_logo do %>
        <%= customization_instance_logo_tag(logo: "app-logo", options: { alt: "Lesli app logo" }) %>
    <% end %>
    <% if engine_navigation_partial %>
        <% header.with_navigation do %>
            <%= render(engine_navigation_partial) %>
        <% end %>
    <% end %>
<% end %>
