<% colors = @lesli.dig(:customization, :colors) || {} %>


<%# Override --lesli-theme-* variables; the shared stylesheet provides defaults. %>
<% if colors.present? %>
    <style data-turbo-track="dynamic">
        :root {
            <% colors.each_pair do |key, value| %>
            <%= "--#{key.to_s.tr('_', '-')}: #{value};" if value %>
            <% end %>
        }
    </style>
<% end %>


<%# Shared assets reload after a deploy; engine styles leave with their pages. %>
<%= stylesheet_link_tag(lesli_asset_path(:lesli_assets, 'application'), media: "all", "data-turbo-track": "reload") %>
<%= stylesheet_link_tag(lesli_asset_path(:lesli_view, 'view'), media: "all", "data-turbo-track": "reload") %>
<%= stylesheet_link_tag(lesli_asset_path(), media: "all", "data-turbo-track": "dynamic") %>


<%# Loading javascripts from engines %> 
<%= javascript_include_tag(lesli_asset_path(:lesli_assets, 'application'), defer: true, "data-turbo-track": "reload") %>
<%= yield(:application_lesli_javascript) %>
