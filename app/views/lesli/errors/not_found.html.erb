<%= render(LesliView::Layout::Container.new("accounts")) do %>
    <%= render LesliView::Partials::Error.new(
        id: "not-found",
        title: "404 #{I18n.t('lesli.shared.message_error_not_found')}",
        message: @message
    ) do |error| %>
        <% error.with_illustration do %>
            <%= render LesliView::Elements::Empty.new(text: nil) %>
        <% end %>
    <% end %>
<% end %>
