<%= render(LesliView::Layout::Container.new("accounts")) do %>
    <%= render LesliView::Partials::Error.new(
        id: "unauthorized",
        title: "403 #{I18n.t('lesli.shared.message_error_unauthorized')}",
        message: I18n.t("lesli.shared.message_error_unauthorized_credentials"),
        tone: :danger
    ) do |error| %>
        <% error.with_illustration do %>
            <span class="material-symbols lesli-error-icon">shield_lock</span>
        <% end %>
        <% error.with_details do %>
            <ul>
                <li>
                    <%= @error_object.dig(:error_details, :controller) %>
                    (<%= @error_object.dig(:error_details, :action) %>)
                </li>
                <li><%= @error_object[:error_role] %></li>
            </ul>
        <% end %>
    <% end %>
<% end %>
